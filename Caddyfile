# Single entrypoint for Bibliocapsa. Routes the API / OPDS / WebDAV / KOSync
# paths to the backend and everything else to the web UI — so the whole app is
# reachable on ONE port (and one Cloudflare route). A real reverse proxy here
# also forwards WebDAV methods (PROPFIND/MKCOL/PUT) correctly, which the Next.js
# rewrite layer does not.
:80 {
	# Compress API JSON and OPDS XML — the FastAPI backend sends them uncompressed,
	# and large library listings/catalogs shrink 5-10x. Caddy skips already-
	# compressed content (EPUBs, images) by content type automatically.
	encode zstd gzip

	# Baseline security headers (TLS/HSTS is owned by the upstream — Cloudflare or
	# your own reverse proxy — since this listens on plain :80 behind it).
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
		# CSP tuned for this app: Next.js + the in-browser epub.js / pdf.js readers
		# (which need eval, web workers, and blob: URLs) and the pervasive inline
		# styles. Book HTML is separately DOMPurify-sanitized. frame-ancestors 'none'
		# is the modern clickjacking guard.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; frame-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
		-Server
	}

	# Request-body ceilings, enforced HERE so an oversize body is refused
	# before it reaches the app (which used to buffer it in full first).
	# Upload routes get the limit their handler enforces plus headroom;
	# everything else on the API is JSON and gets a small cap.
	@uploads path /api/calibre/upload /api/goodreads/import /api/goodreads/preview-shelves
	@covers  path /api/native/books/*/cover
	@dav     path /dav /dav/*
	@backend path /api/* /opds /opds/* /users/* /syncs/* /healthcheck

	route {
		handle @uploads {
			request_body {
				max_size 320MB
			}
			reverse_proxy bibliocapsa:8000 {
				header_up X-Forwarded-For {remote_host}
			}
		}
		handle @covers {
			request_body {
				max_size 12MB
			}
			reverse_proxy bibliocapsa:8000 {
				header_up X-Forwarded-For {remote_host}
			}
		}
		handle @dav {
			request_body {
				max_size 64MB
			}
			reverse_proxy bibliocapsa:8000 {
				header_up X-Forwarded-For {remote_host}
			}
		}
		handle @backend {
			request_body {
				max_size 8MB
			}
			# X-Forwarded-For is set from the real socket peer and never taken from
			# the client, so the app can key rate limits on it. (Cloudflare's own
			# CF-Connecting-IP and CF-Visitor headers pass through untouched.)
			reverse_proxy bibliocapsa:8000 {
				header_up X-Forwarded-For {remote_host}
			}
		}
		handle {
			reverse_proxy web:3000
		}
	}
}
